# Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ============================================
# APPLICATION SETTINGS
# ============================================
VITE_APP_NAME=Dvyb Web
VITE_MODE=development
VITE_SERVER_PORT=3010
VITE_TIMEZONE=Asia/Kolkata

# ============================================
# API URLS
# ============================================
VITE_BASE_DEVELOPMENT_URL=http://localhost:3010
VITE_BASE_PRODUCTION_URL=https://api.yourdomain.com

# ============================================
# FIREBASE CONFIGURATION (Client-Safe)
# ============================================
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase App Check
VITE_FIREBASE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=true

# Firebase Collections
VITE_FIREBASE_B2C_COLLECTION=b2c_users
VITE_FIREBASE_B2B_COLLECTION=B2BBulkOrders_users
VITE_FIREBASE_PRODUCTS_COLLECTION=products
VITE_FIREBASE_USERS_COLLECTION=users
VITE_FIREBASE_ORDERS_COLLECTION=orders
VITE_FIREBASE_TRYON_COLLECTION=user_tryons

# User Roles
VITE_DEFAULT_USER_ROLE_B2C=B2C
VITE_DEFAULT_USER_ROLE_B2B=B2B

# ============================================
# CLOUDINARY (Public keys for client)
# ============================================
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key

# ⚠️ SERVER-ONLY: Never expose to client
VITE_CLOUDINARY_API_SECRET=your_api_secret_here

# ============================================
# PAYMENT GATEWAY (Razorpay)
# ============================================
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# ⚠️ SERVER-ONLY: Never expose to client
VITE_RAZORPAY_KEY_SECRET=your_secret_here

# ============================================
# AI SERVICES (SERVER-ONLY)
# ============================================
# ⚠️ These should NEVER be exposed to client
# Remove VITE_ prefix to keep them server-side only

# Gemini API
GEMINI_API_KEY=your_gemini_key_here
GEMINI_SAREE_KEY=your_saree_key_here
GEMINI_LEHENGA_KEY=your_lehenga_key_here
GEMINI_KURTI_KEY=your_kurti_key_here
GEMINI_ANARKALI_KEY=your_anarkali_key_here

# Kling API
VITE_KLING_API_BASE_URL=https://api.klingai.com/v1
VITE_KLING_ACCESS_KEY=your_access_key
VITE_KLING_SECRET_KEY=your_secret_key

# FashionAI API
FASHN_API_KEY=your_fashn_key
VITE_FASHN_API_URL=https://api.fashn.ai/v1
VITE_FASHN_AUTH_HEADER=your_auth_header

# MiniMax API
MINIMAX_API_KEY=your_minimax_jwt_token

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
VITE_USE_EMULATOR=false

# Google Auth (Optional)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_FRONTEND_CALLBACK_URL=

# ============================================
# REDIS (Optional - for rate limiting)
# ============================================
REDIS_URL=redis://localhost:6379
